// =============================================================================
// Synapse - Módulo de Orçamentos + Autenticação
// Schema Prisma (PostgreSQL / Neon)
//
// O Prisma é a ÚNICA fonte de verdade do banco de dados.
// Fluxo em desenvolvimento:  npm run prisma:migrate
// Fluxo em produção (Render): npm run prisma:deploy
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso (RBAC) reconhecidos pelo sistema.
enum PerfilUsuario {
  ORCAMENTISTA
  PLANEJADOR
  SUPERVISOR
  ADMIN
}

/// Fluxo operacional do orçamento (validado pelo processo de engenharia).
/// Ordem natural do ciclo: levantamento → envio → aprovação → planejamento → OSI.
enum StatusOrcamento {
  /// Estado inicial: levantamento em campo.
  VISITA_TECNICA
  /// Estruturado e enviado ao cliente para análise.
  AGUARDANDO_APROVACAO
  /// Aprovado pelo cliente — gatilho do Supervisão de Planejamento.
  APROVADO
  /// Desaprovado ou cancelado.
  DESATIVADO
  /// Fase intermediária: acionamento do planejamento.
  ENCAMINHADO_OSI
  /// Ordem de Serviço Interna emitida.
  OSI_EMITIDA
}

/// Ciclo de vida operacional da obra (governança ISO 9001).
/// Isola a execução em campo do ciclo comercial do orçamento.
/// Natureza de uma revisão de valor do orçamento.
enum TipoAlteracaoRevisao {
  /// Substitui o valor anterior: passa a ser o valor base vigente.
  REVISAO_SUBSTITUTIVA
  /// Soma ao valor base vigente.
  ADITIVO_FINANCEIRO
}

/// Situação de aprovação de uma revisão de valor.
enum StatusAprovacaoRevisao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusBoletim {
  /// Boletim lançado e ainda não aprovado pela Vale: não entra no acumulado.
  EM_ANALISE
  /// Aprovado: conta no total acumulado e no Real da Curva S financeira.
  APROVADO
  /// Rejeitado ou cancelado: fica no histórico, fora dos cálculos.
  REJEITADO
}

enum StatusObra {
  /// Aprovada e com documentação de partida pendente (OSI e/ou Ata).
  PARA_INICIAR
  /// Serviço em execução em campo.
  EM_ANDAMENTO
  /// Execução interrompida temporariamente.
  PARALISADA
  /// Serviço concluído.
  CONCLUIDA
}

/// Carteira de planejamento à qual a obra pertence no dashboard executivo.
enum CategoriaObra {
  /// Serviços de apoio / cadeia de ajuda.
  CADEIA_DE_AJUDA
  /// Obras sob gestão direta da coordenação.
  CARTEIRA_DA_COORDENACAO
}

/// Situação de uma restrição da metodologia 6WLA (lookahead de 6 semanas).
enum StatusRestricao {
  PENDENTE
  EM_ANDAMENTO
  RESOLVIDA
  CANCELADA
}

/// Natureza da localização da obra: ponto geográfico ou trecho linear (km).
/// Categorias de restrição do lookahead (6WLA).
enum TipoRestricaoAtividade {
  PROJETOS
  SUPRIMENTOS
  LIBERACAO_AREA
  SMS
  EQUIPAMENTO
}

/// Eventos do histórico de importação de cronogramas.
enum AcaoHistoricoCronograma {
  IMPORTADO
  FALHA
  EXCLUIDO
}

/// Status da restrição de atividade do lookahead (Last Planner System).
enum StatusRestricaoAtividade {
  PENDENTE
  BAIXADA
}

enum TipoLocalizacaoObra {
  PONTO
  TRECHO
}

/// Situação do Relatório Diário de Obra (RDO).
enum StatusRelatorioObra {
  RASCUNHO
  ENVIADO
  APROVADO
}

/// Situação de uma atividade/tarefa da obra.
enum StatusAtividadeObra {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

/// Gravidade de uma ocorrência registrada em campo.
enum GravidadeOcorrencia {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

/// Tipo de mídia anexada à obra/relatório.
enum TipoMidiaObra {
  FOTO
  VIDEO
}

/// Natureza da demanda da equipe de planejamento.
enum TipoTarefa {
  /// Rotina semanal fixa (vence sempre no mesmo dia da semana).
  FIXA_RECORRENTE
  /// Demanda pontual, com data de vencimento própria.
  AVULSA
}

/// Dia da semana de vencimento de uma rotina recorrente.
enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

/// Situação de uma tarefa da equipe.
enum StatusTarefa {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

/// Prioridade de uma tarefa da equipe.
enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

// -----------------------------------------------------------------------------
// Usuários (autenticação JWT)
// -----------------------------------------------------------------------------
model Usuario {
  id         Int           @id @default(autoincrement())
  nome       String        @db.VarChar(255)
  matricula  String?       @unique @db.VarChar(30)
  email      String        @unique @db.VarChar(255)
  senha_hash String        @db.VarChar(255)
  perfil     PerfilUsuario @default(ORCAMENTISTA)
  ativo      Boolean       @default(true)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  orcamentos_orcamentista Orcamento[]                     @relation("Orcamentista")
  orcamentos_planejador   Orcamento[]                     @relation("Planejador")
  revisoes                OrcamentoRevisao[]
  obras_planejador        Obra[]                          @relation("ObraPlanejador")
  obras_coplanejadas      ObraPlanejador[]
  obras_osi_emitidas      Obra[]                          @relation("ObraOsiEmissor")
  relatorios_autor        ObraRelatorio[]                 @relation("RelatorioAutor")
  comentarios_autor       ObraComentario[]                @relation("ComentarioAutor")
  tarefas                 Tarefa[]                        @relation("TarefaResponsavel")
  cronogramas_enviados    VersaoCronograma[]              @relation("CronogramaAutor")
  restricoes_atividades   RestricaoAtividade[]            @relation("RestricaoAtividadeAutor")
  historico_cronogramas   HistoricoImportacaoCronograma[] @relation("HistoricoCronogramaUsuario")
  aditivos_registrados    TermoAditivo[]                  @relation("AditivoAutor")
  boletins_registrados    BoletimMedicao[]                @relation("BoletimAutor")

  @@map("usuarios")
}

// -----------------------------------------------------------------------------
// Configurações internas do sistema (nunca expostas pela API)
// -----------------------------------------------------------------------------
model ConfiguracaoSistema {
  /// Identificador da configuração (ex.: "jwt_secret").
  chave      String   @id @db.VarChar(100)
  valor      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("configuracoes_sistema")
}

// -----------------------------------------------------------------------------
// Orçamentos
// -----------------------------------------------------------------------------
model Orcamento {
  id                    Int             @id @default(autoincrement())
  /// Programa de Engenharia / PEP — obrigatório (regra ISO 9001).
  pep                   String          @db.VarChar(100)
  cliente               String?         @db.VarChar(255)
  /// Solicitação de Serviço.
  ss                    String?         @db.VarChar(60)
  descricao             String?
  endereco              String?
  documentos_referencia String?
  status                StatusOrcamento @default(VISITA_TECNICA)
  /// Valor vigente — atualizado a cada revisão registrada.
  valor                 Decimal         @default(0) @db.Decimal(14, 2)
  /// Só pode ser gravado por PLANEJADOR, SUPERVISOR ou ADMIN (validado no service).
  art                   String?         @db.VarChar(120)
  /// Autor do orçamento.
  orcamentista_id       Int?
  /// Só pode ser atribuído por SUPERVISOR ou ADMIN (validado no service).
  planejador_id         Int?
  /// URL Cloudinary da foto principal — obrigatória.
  foto_1                String
  foto_2                String?
  foto_3                String?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  orcamentista Usuario?           @relation("Orcamentista", fields: [orcamentista_id], references: [id], onDelete: SetNull)
  planejador   Usuario?           @relation("Planejador", fields: [planejador_id], references: [id], onDelete: SetNull)
  revisoes     OrcamentoRevisao[]
  fiscais      OrcamentoFiscal[]
  peps         OrcamentoPep[]
  obra         Obra?

  @@index([status])
  @@index([pep])
  @@map("orcamentos")
}

// -----------------------------------------------------------------------------
// PEPs (CC) do orçamento — vários por orçamento, um ativo por vez.
// O PEP ativo é espelhado em `orcamentos.pep` (usado em buscas, listas e relatórios).
// -----------------------------------------------------------------------------
model OrcamentoPep {
  id           Int      @id @default(autoincrement())
  orcamento_id Int
  pep          String   @db.VarChar(100)
  ativo        Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)

  @@unique([orcamento_id, pep], name: "uq_pep_por_orcamento")
  @@index([orcamento_id])
  @@map("orcamento_peps")
}

// -----------------------------------------------------------------------------
// Fiscais do orçamento (N por orçamento — nome + contato)
// -----------------------------------------------------------------------------
model OrcamentoFiscal {
  id           Int      @id @default(autoincrement())
  orcamento_id Int
  nome         String   @db.VarChar(255)
  /// Telefone e/ou e-mail de contato do fiscal.
  contato      String?  @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)

  @@index([orcamento_id])
  @@index([nome])
  @@map("orcamento_fiscais")
}

// -----------------------------------------------------------------------------
// Histórico de revisões de valor (versionamento sequencial)
// -----------------------------------------------------------------------------
model OrcamentoRevisao {
  id               Int                    @id @default(autoincrement())
  orcamento_id     Int
  /// 0 = Rev 00, 1 = Rev 01, ...
  numero_revisao   Int
  valor            Decimal                @db.Decimal(14, 2)
  /// Justificativa obrigatória da alteração de valor.
  observacao       String
  /// Natureza da alteração: substitui o valor base ou soma um aditivo.
  tipo_alteracao   TipoAlteracaoRevisao   @default(REVISAO_SUBSTITUTIVA)
  /// Só revisões APROVADAS entram no cálculo do valor vigente.
  status_aprovacao StatusAprovacaoRevisao @default(APROVADO)
  /// URL Cloudinary do documento comprobatório (PDF ou imagem).
  anexo_url        String?
  /// Quem gerou a revisão.
  usuario_id       Int?
  created_at       DateTime               @default(now()) @db.Timestamptz(6)

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@unique([orcamento_id, numero_revisao], name: "uq_revisao_por_orcamento")
  @@map("orcamento_revisoes")
}

// -----------------------------------------------------------------------------
// Obras — ciclo operacional de execução (ISO 9001)
//
// Relação 1:1 com o orçamento aprovado. O orçamento carrega o ciclo comercial
// (levantamento → aprovação); esta tabela carrega a governança de execução:
// documento de partida (OSI + Ata de Reunião) e o ciclo de vida em campo.
// -----------------------------------------------------------------------------
model Obra {
  id              Int            @id @default(autoincrement())
  orcamento_id    Int            @unique
  /// Ciclo de vida operacional em campo.
  status          StatusObra     @default(PARA_INICIAR)
  /// Carteira do dashboard de planejamento (Cadeia de Ajuda ou Coordenação).
  categoria       CategoriaObra?
  /// Planejador PRINCIPAL — espelho do primeiro item de `planejadores`, mantido
  /// para os painéis e integrações que leem um único responsável.
  planejador_id   Int?
  /// Número da Ordem de Serviço Interna (OSI).
  osi_numero      String?        @db.VarChar(60)
  osi_emitida_em  DateTime?      @db.Timestamptz(6)
  /// Usuário que registrou a emissão da OSI.
  osi_emitida_por Int?
  /// URL Cloudinary da OSI assinada (só ela conclui a pendência da OSI).
  osi_anexo_url   String?
  osi_anexada_em  DateTime?      @db.Timestamptz(6)
  /// Usuário que anexou a OSI assinada.
  osi_anexada_por Int?
  /// URL Cloudinary da Ata de Reunião de Partida (Kick-off).
  ata_partida_url String?
  /// Observações gerais do planejamento.
  observacoes     String?
  /// Contrato-mãe com a Vale ao qual a obra (SS) está vinculada.
  contrato_id     Int?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  orcamento           Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)
  contrato            Contrato? @relation(fields: [contrato_id], references: [id], onDelete: SetNull)
  planejador          Usuario?  @relation("ObraPlanejador", fields: [planejador_id], references: [id], onDelete: SetNull)
  osi_emitida_usuario Usuario?  @relation("ObraOsiEmissor", fields: [osi_emitida_por], references: [id], onDelete: SetNull)

  /// Todos os planejadores responsáveis, em ordem (0 = principal).
  planejadores          ObraPlanejador[]
  localizacoes          ObraLocalizacao[]
  avanco_fisico         ObraAvancoFisico[]
  relatorios            ObraRelatorio[]
  atividades            ObraAtividade[]
  restricoes            ObraRestricao[]
  ocorrencias           ObraOcorrencia[]
  comentarios           ObraComentario[]
  midias                ObraMidia[]
  tarefas               Tarefa[]
  cronogramas           VersaoCronograma[]
  restricoes_atividades RestricaoAtividade[]
  historico_cronogramas HistoricoImportacaoCronograma[]
  /// Valores medidos desta obra (SS) nos Boletins de Medição do contrato.
  itens_medicao         BoletimMedicaoItem[]

  @@index([status])
  @@index([planejador_id])
  @@index([contrato_id])
  @@map("obras")
}

// -----------------------------------------------------------------------------
// Planejadores responsáveis pela obra (N:N — empreendimentos de grande porte)
// -----------------------------------------------------------------------------
model ObraPlanejador {
  obra_id    Int
  usuario_id Int
  /// Posição na equipe: 0 = principal, 1 = secundário, ...
  ordem      Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  obra    Obra    @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([obra_id, usuario_id])
  @@index([usuario_id])
  @@map("obra_planejadores")
}

// -----------------------------------------------------------------------------
// Múltiplas localizações da obra (pontos geográficos ou trechos em km)
// -----------------------------------------------------------------------------
model ObraLocalizacao {
  id         Int                 @id @default(autoincrement())
  obra_id    Int
  descricao  String              @db.VarChar(255)
  tipo       TipoLocalizacaoObra @default(PONTO)
  /// Coordenadas do ponto ou do início do trecho.
  latitude   Decimal?            @db.Decimal(10, 7)
  longitude  Decimal?            @db.Decimal(10, 7)
  /// Quilometragem inicial/final para obras lineares (tubulações, ferrovias).
  km_inicial Decimal?            @db.Decimal(10, 3)
  km_final   Decimal?            @db.Decimal(10, 3)
  /// Referência livre (ex.: "KM 12+350", "Portão Norte", "Travessia do rio").
  referencia String?             @db.VarChar(120)
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@map("obra_localizacoes")
}

// -----------------------------------------------------------------------------
// Avanço físico semanal (base histórica da Curva S)
// -----------------------------------------------------------------------------
model ObraAvancoFisico {
  id               Int      @id @default(autoincrement())
  obra_id          Int
  data             DateTime @db.Date
  semana           Int
  /// Avanço previsto no período (percentual da obra).
  fisico_prev      Decimal  @default(0) @db.Decimal(6, 2)
  /// Linha de base prevista no período.
  fisico_lb_prev   Decimal  @default(0) @db.Decimal(6, 2)
  /// Avanço realizado no período.
  fisico_real      Decimal  @default(0) @db.Decimal(6, 2)
  /// Tendência acumulada.
  fisico_tend_acum Decimal  @default(0) @db.Decimal(6, 2)
  /// Previsto acumulado.
  fisico_prev_acum Decimal  @default(0) @db.Decimal(6, 2)
  /// Realizado acumulado.
  fisico_real_acum Decimal  @default(0) @db.Decimal(6, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@unique([obra_id, data], name: "uq_avanco_data_por_obra", map: "obra_avanco_fisico_obra_id_data_key")
  @@index([obra_id])
  @@map("obra_avanco_fisico")
}

// -----------------------------------------------------------------------------
// Relatório Diário de Obra (RDO) — cabeçalho do registro de campo
// -----------------------------------------------------------------------------
model ObraRelatorio {
  id         Int                 @id @default(autoincrement())
  obra_id    Int
  data       DateTime            @db.Date
  titulo     String              @db.VarChar(200)
  resumo     String?
  status     StatusRelatorioObra @default(RASCUNHO)
  autor_id   Int?
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra        Obra             @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  autor       Usuario?         @relation("RelatorioAutor", fields: [autor_id], references: [id], onDelete: SetNull)
  atividades  ObraAtividade[]
  ocorrencias ObraOcorrencia[]
  comentarios ObraComentario[]
  midias      ObraMidia[]

  @@index([obra_id])
  @@index([data])
  @@map("obra_relatorios")
}

// -----------------------------------------------------------------------------
// Atividades / tarefas da obra (podem pertencer a um RDO ou ser avulsas)
// -----------------------------------------------------------------------------
model ObraAtividade {
  id           Int                 @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  titulo       String              @db.VarChar(200)
  descricao    String?
  status       StatusAtividadeObra @default(PENDENTE)
  responsavel  String?             @db.VarChar(120)
  prazo        DateTime?           @db.Date
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@index([status])
  @@map("obra_atividades")
}

// -----------------------------------------------------------------------------
// Restrições 6WLA (lookahead de 6 semanas) — tabela de constraints do dashboard
// -----------------------------------------------------------------------------
model ObraRestricao {
  id                  Int             @id @default(autoincrement())
  obra_id             Int
  /// Etapa/frente de serviço (ex.: "Mobilização", "Tubulação").
  etapa               String?         @db.VarChar(120)
  /// Atividade impactada pela restrição.
  atividade           String          @db.VarChar(200)
  /// Descrição objetiva do impedimento.
  descricao           String
  /// Plano de ação para remoção da restrição (Q1/RFT).
  plano_acao          String?
  /// Responsável pela remoção da restrição.
  responsavel         String?         @db.VarChar(120)
  /// Empresa responsável (ex.: Vale, Omega Service).
  empresa_responsavel String?         @db.VarChar(120)
  status              StatusRestricao @default(PENDENTE)
  /// Prazo (QUANDO) para remoção da restrição.
  prazo               DateTime?       @db.Date
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([status])
  @@index([prazo])
  @@map("obra_restricoes")
}

// -----------------------------------------------------------------------------
// Ocorrências registradas em campo (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraOcorrencia {
  id           Int                 @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  descricao    String
  gravidade    GravidadeOcorrencia @default(MEDIA)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@map("obra_ocorrencias")
}

// -----------------------------------------------------------------------------
// Comentários da obra (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraComentario {
  id           Int      @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  autor_id     Int?
  texto        String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)
  autor     Usuario?       @relation("ComentarioAutor", fields: [autor_id], references: [id], onDelete: SetNull)

  @@index([obra_id])
  @@index([relatorio_id])
  @@map("obra_comentarios")
}

// -----------------------------------------------------------------------------
// Fotos e vídeos da obra (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraMidia {
  id           Int           @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  tipo         TipoMidiaObra @default(FOTO)
  url          String
  legenda      String?       @db.VarChar(255)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@index([tipo])
  @@map("obra_midias")
}

// -----------------------------------------------------------------------------
// Tarefas da equipe de planejamento (gestão de demandas e carga da equipe)
//
// Rotinas fixas semanais e demandas avulsas, com farol de prazo calculado no
// service. Concluir fora do prazo exige justificativa (validado no service).
// -----------------------------------------------------------------------------
model Tarefa {
  id                   Int              @id @default(autoincrement())
  titulo               String           @db.VarChar(200)
  descricao            String?
  tipo                 TipoTarefa       @default(AVULSA)
  /// Obrigatório quando tipo = FIXA_RECORRENTE (validado no service).
  dia_recorrencia      DiaSemana?
  data_vencimento      DateTime         @db.Timestamptz(6)
  status               StatusTarefa     @default(A_FAZER)
  prioridade           PrioridadeTarefa @default(MEDIA)
  /// Colaborador responsável pela tarefa.
  usuario_id           Int
  /// Obra/SS relacionada (opcional).
  obra_id              Int?
  /// Preenchida quando a tarefa é concluída após o vencimento.
  justificativa_atraso String?
  concluido_em         DateTime?        @db.Timestamptz(6)
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  usuario Usuario @relation("TarefaResponsavel", fields: [usuario_id], references: [id], onDelete: Restrict)
  obra    Obra?   @relation(fields: [obra_id], references: [id], onDelete: SetNull)

  @@index([usuario_id, status])
  @@index([status])
  @@index([data_vencimento])
  @@index([obra_id])
  @@map("tarefas")
}

// -----------------------------------------------------------------------------
// Cronogramas da obra — versionamento (snapshot por upload do planejador)
// Cada upload do modelo padrão (.xlsx) gera uma versão imutável ("Rev 00",
// "Rev 01", ...) com as atividades da EAP, a Curva S e os histogramas de
// recursos, garantindo rastreabilidade histórica para Curva S, CPM e 6WLA.
// -----------------------------------------------------------------------------
model VersaoCronograma {
  id                      String    @id @default(uuid()) @db.Uuid
  obra_id                 Int
  /// Rótulo da revisão (ex.: "Rev 00", "Rev 01").
  versao                  String    @db.VarChar(30)
  /// Sequencial da revisão dentro da obra (0, 1, 2, ...).
  numero_revisao          Int
  /// Momento do snapshot (data de status informada ou data do upload).
  data_snapshot           DateTime  @db.Timestamptz(6)
  /// Período de referência do relatório semanal (aba Dashboard).
  periodo_inicio          DateTime? @db.Date
  periodo_fim             DateTime? @db.Date
  autor_id                Int?
  /// URL do arquivo original (Cloudinary).
  arquivo_url             String?
  arquivo_nome            String?   @db.VarChar(255)
  /// SHA-256 do arquivo enviado (detecção de reenvio da mesma planilha).
  arquivo_hash            String?   @db.VarChar(64)
  arquivo_tamanho         Int?
  observacao              String?
  /// Indicadores gerais: % previsto/real, datas LB e tendência, contagens.
  resumo                  Json?
  /// Série semanal da Curva S física e financeira (aba Avanço_Físico&Financeiro).
  curva_s                 Json?
  /// Histograma semanal de mão de obra direta/indireta por função (aba MOD_MOI).
  histograma_mao_de_obra  Json?
  /// Histograma semanal de equipamentos (aba EQP).
  histograma_equipamentos Json?
  /// Calendário de trabalho da obra (expediente, feriados) usado no CPM e nas curvas.
  calendario              Json?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  obra       Obra                            @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  autor      Usuario?                        @relation("CronogramaAutor", fields: [autor_id], references: [id], onDelete: SetNull)
  atividades AtividadeCronograma[]
  historico  HistoricoImportacaoCronograma[]

  @@unique([obra_id, numero_revisao])
  @@index([obra_id])
  @@index([obra_id, arquivo_hash])
  @@map("versoes_cronograma")
}

model AtividadeCronograma {
  id                     String    @id @default(uuid()) @db.Uuid
  versao_cronograma_id   String    @db.Uuid
  /// Posição da linha no arquivo (preserva a ordem da EAP).
  ordem                  Int
  /// Código EDT/WBS (ex.: "1.4.1.2").
  codigo_atividade       String    @db.VarChar(60)
  /// Código EDT do item pai na EAP (nulo para a raiz).
  codigo_pai             String?   @db.VarChar(60)
  descricao              String
  /// Profundidade na EAP (1 = raiz).
  nivel                  Int
  /// Verdadeiro para itens de agrupamento (possuem filhos na EAP).
  resumo                 Boolean   @default(false)
  /// Datas de tendência (cronograma atualizado).
  data_inicio            DateTime? @db.Timestamptz(6)
  data_fim               DateTime? @db.Timestamptz(6)
  /// Datas da linha de base (LB).
  data_inicio_lb         DateTime? @db.Timestamptz(6)
  data_fim_lb            DateTime? @db.Timestamptz(6)
  /// Percentuais de 0 a 100.
  avanco_fisico_previsto Float     @default(0)
  avanco_fisico_real     Float     @default(0)
  recursos_mao_de_obra   Json?
  recursos_equipamentos  Json?
  /// Precedências no formato do MS Project (ex.: "1.3.2TI+2 dias;1.3.4").
  predecessoras          String?
  /// Id da tarefa no MS Project (referência das predecessoras numéricas).
  id_origem              Int?
  /// Folga total calculada pelo CPM, em dias úteis (negativa = atraso).
  folga_total_dias       Float?
  caminho_critico        Boolean   @default(false)
  /// Campos de origem do MS Project (Id, CPM do Project, datas reais, restrição, farol).
  dados_origem           Json?

  versao     VersaoCronograma     @relation(fields: [versao_cronograma_id], references: [id], onDelete: Cascade)
  restricoes RestricaoAtividade[]

  @@index([versao_cronograma_id, ordem])
  @@index([versao_cronograma_id, codigo_atividade])
  @@map("atividades_cronograma")
}

// -----------------------------------------------------------------------------
// Restrições das atividades do cronograma (Lookahead 6WLA / Last Planner)
// Vinculadas à atividade da versão em que foram cadastradas; `codigo_atividade`
// (EDT) permite que a restrição acompanhe a atividade nas revisões seguintes.
// -----------------------------------------------------------------------------
model RestricaoAtividade {
  id               String                   @id @default(uuid()) @db.Uuid
  obra_id          Int
  atividade_id     String                   @db.Uuid
  /// EDT da atividade (chave estável entre revisões do cronograma).
  codigo_atividade String                   @db.VarChar(60)
  tipo             TipoRestricaoAtividade
  descricao        String
  status           StatusRestricaoAtividade @default(PENDENTE)
  responsavel      String?                  @db.VarChar(255)
  /// Plano de ação: como e por quem a restrição será removida.
  plano_acao       String?
  /// Data limite para remoção da restrição.
  data_limite      DateTime?                @db.Date
  /// Momento em que a restrição foi baixada (removida).
  data_baixa       DateTime?                @db.Timestamptz(6)
  criado_por       Int?
  created_at       DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  obra      Obra                @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  atividade AtividadeCronograma @relation(fields: [atividade_id], references: [id], onDelete: Cascade)
  autor     Usuario?            @relation("RestricaoAtividadeAutor", fields: [criado_por], references: [id], onDelete: SetNull)

  @@index([obra_id, codigo_atividade])
  @@index([atividade_id])
  @@index([obra_id, status])
  @@map("restricoes_atividades")
}

// -----------------------------------------------------------------------------
// Histórico de importação de cronogramas (auditoria)
// Registra cada importação, falha e exclusão de revisão. O registro permanece
// mesmo depois que a revisão é excluída (versao_id fica nulo).
// -----------------------------------------------------------------------------
model HistoricoImportacaoCronograma {
  id               String                  @id @default(uuid()) @db.Uuid
  obra_id          Int
  versao_id        String?                 @db.Uuid
  acao             AcaoHistoricoCronograma
  /// Rótulo da revisão envolvida (preservado após a exclusão).
  versao           String?                 @db.VarChar(30)
  arquivo_nome     String?                 @db.VarChar(255)
  arquivo_hash     String?                 @db.VarChar(64)
  arquivo_url      String?
  total_atividades Int?
  usuario_id       Int?
  /// Motivo da exclusão, mensagem da falha, avisos e contagens.
  detalhes         Json?
  created_at       DateTime                @default(now()) @db.Timestamptz(6)

  obra           Obra              @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  versaoRegistro VersaoCronograma? @relation(fields: [versao_id], references: [id], onDelete: SetNull)
  usuario        Usuario?          @relation("HistoricoCronogramaUsuario", fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([obra_id, created_at])
  @@map("historico_importacao_cronogramas")
}

// -----------------------------------------------------------------------------
// Contratos com a Vale (ex.: CT-251 Eletromecânica) e Termos Aditivos (TAC)
//
// O teto financeiro vigente do contrato é o valor inicial somado aos aditivos;
// cada TAC guarda o novo valor total que passou a valer na sua assinatura.
// As obras (SS) se vinculam ao contrato-mãe por `obras.contrato_id`.
// -----------------------------------------------------------------------------
model Contrato {
  id            Int      @id @default(autoincrement())
  /// Identificação do contrato na Vale (ex.: "CT-251").
  id_vale       String   @unique @db.VarChar(60)
  descricao     String
  valor_inicial Decimal  @db.Decimal(14, 2)
  data_inicio   DateTime @db.Date
  data_fim      DateTime @db.Date
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  aditivos TermoAditivo[]
  obras    Obra[]
  boletins BoletimMedicao[]

  @@map("contratos")
}

model TermoAditivo {
  id               Int      @id @default(autoincrement())
  contrato_id      Int
  /// Identificação do termo (ex.: "TAC 01"), única dentro do contrato.
  numero_tac       String   @db.VarChar(30)
  valor_aditivo    Decimal  @db.Decimal(14, 2)
  /// Teto do contrato depois deste aditivo (valor inicial + aditivos até ele).
  novo_valor_total Decimal  @db.Decimal(14, 2)
  data_assinatura  DateTime @db.Date
  motivo           String
  /// Quem registrou o aditivo no sistema.
  usuario_id       Int?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  contrato Contrato @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  Usuario? @relation("AditivoAutor", fields: [usuario_id], references: [id], onDelete: SetNull)

  @@unique([contrato_id, numero_tac], name: "uq_tac_por_contrato")
  @@index([contrato_id])
  @@map("termos_aditivos")
}

// -----------------------------------------------------------------------------
// Boletins de Medição (BMM) do contrato e o detalhamento por obra/SS
//
// O ciclo de medição padrão vai do dia 16 de um mês ao dia 15 do seguinte; o
// boletim é identificado pelo mês em que o ciclo termina. O valor medido do
// boletim é a soma dos seus itens (uma linha por obra/SS medida no ciclo).
// -----------------------------------------------------------------------------
model BoletimMedicao {
  id           Int           @id @default(autoincrement())
  contrato_id  Int
  /// Identificação do boletim na Vale (ex.: "BMM19"), única dentro do contrato.
  numero_bmm   String        @db.VarChar(30)
  valor_medido Decimal       @db.Decimal(14, 2)
  ciclo_inicio DateTime      @db.Date
  ciclo_fim    DateTime      @db.Date
  status       StatusBoletim @default(EM_ANALISE)
  observacao   String?
  /// Quem lançou o boletim no sistema.
  usuario_id   Int?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  contrato Contrato             @relation(fields: [contrato_id], references: [id], onDelete: Cascade)
  usuario  Usuario?             @relation("BoletimAutor", fields: [usuario_id], references: [id], onDelete: SetNull)
  itens    BoletimMedicaoItem[]

  @@unique([contrato_id, numero_bmm], name: "uq_bmm_por_contrato")
  @@index([contrato_id, ciclo_fim])
  @@map("boletins_medicao")
}

model BoletimMedicaoItem {
  id         Int      @id @default(autoincrement())
  boletim_id Int
  obra_id    Int
  /// Valor medido desta obra/SS no ciclo do boletim.
  valor      Decimal  @db.Decimal(14, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  boletim BoletimMedicao @relation(fields: [boletim_id], references: [id], onDelete: Cascade)
  /// Restrict: uma obra com valor medido em boletim não pode ser apagada sem antes tratar a medição.
  obra    Obra           @relation(fields: [obra_id], references: [id], onDelete: Restrict)

  @@unique([boletim_id, obra_id], name: "uq_item_por_boletim_obra")
  @@index([obra_id])
  @@map("boletim_medicao_itens")
}

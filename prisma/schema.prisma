// =============================================================================
// Synapse - Módulo de Orçamentos + Autenticação
// Schema Prisma (PostgreSQL / Neon)
//
// O Prisma é a ÚNICA fonte de verdade do banco de dados.
// Fluxo em desenvolvimento:  npm run prisma:migrate
// Fluxo em produção (Render): npm run prisma:deploy
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso (RBAC) reconhecidos pelo sistema.
enum PerfilUsuario {
  ORCAMENTISTA
  PLANEJADOR
  SUPERVISOR
  ADMIN
}

/// Fluxo operacional do orçamento (validado pelo processo de engenharia).
/// Ordem natural do ciclo: levantamento → envio → aprovação → planejamento → OSI.
enum StatusOrcamento {
  /// Estado inicial: levantamento em campo.
  VISITA_TECNICA
  /// Estruturado e enviado ao cliente para análise.
  AGUARDANDO_APROVACAO
  /// Aprovado pelo cliente — gatilho do Supervisão de Planejamento.
  APROVADO
  /// Desaprovado ou cancelado.
  DESATIVADO
  /// Fase intermediária: acionamento do planejamento.
  ENCAMINHADO_OSI
  /// Ordem de Serviço Interna emitida.
  OSI_EMITIDA
}

/// Ciclo de vida operacional da obra (governança ISO 9001).
/// Isola a execução em campo do ciclo comercial do orçamento.
enum StatusObra {
  /// Aprovada e com documentação de partida pendente (OSI e/ou Ata).
  PARA_INICIAR
  /// Serviço em execução em campo.
  EM_ANDAMENTO
  /// Execução interrompida temporariamente.
  PARALISADA
  /// Serviço concluído.
  CONCLUIDA
}

/// Natureza da localização da obra: ponto geográfico ou trecho linear (km).
enum TipoLocalizacaoObra {
  PONTO
  TRECHO
}

/// Situação do Relatório Diário de Obra (RDO).
enum StatusRelatorioObra {
  RASCUNHO
  ENVIADO
  APROVADO
}

/// Situação de uma atividade/tarefa da obra.
enum StatusAtividadeObra {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

/// Gravidade de uma ocorrência registrada em campo.
enum GravidadeOcorrencia {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

/// Tipo de mídia anexada à obra/relatório.
enum TipoMidiaObra {
  FOTO
  VIDEO
}

// -----------------------------------------------------------------------------
// Usuários (autenticação JWT)
// -----------------------------------------------------------------------------
model Usuario {
  id         Int           @id @default(autoincrement())
  nome       String        @db.VarChar(255)
  matricula  String?       @unique @db.VarChar(30)
  email      String        @unique @db.VarChar(255)
  senha_hash String        @db.VarChar(255)
  perfil     PerfilUsuario @default(ORCAMENTISTA)
  ativo      Boolean       @default(true)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  orcamentos_orcamentista Orcamento[]        @relation("Orcamentista")
  orcamentos_planejador   Orcamento[]        @relation("Planejador")
  revisoes                OrcamentoRevisao[]
  obras_planejador        Obra[]             @relation("ObraPlanejador")
  obras_osi_emitidas      Obra[]             @relation("ObraOsiEmissor")
  relatorios_autor        ObraRelatorio[]    @relation("RelatorioAutor")
  comentarios_autor       ObraComentario[]   @relation("ComentarioAutor")

  @@map("usuarios")
}

// -----------------------------------------------------------------------------
// Configurações internas do sistema (nunca expostas pela API)
// -----------------------------------------------------------------------------
model ConfiguracaoSistema {
  /// Identificador da configuração (ex.: "jwt_secret").
  chave      String   @id @db.VarChar(100)
  valor      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("configuracoes_sistema")
}

// -----------------------------------------------------------------------------
// Orçamentos
// -----------------------------------------------------------------------------
model Orcamento {
  id                    Int             @id @default(autoincrement())
  /// Programa de Engenharia / PEP — obrigatório (regra ISO 9001).
  pep                   String          @db.VarChar(100)
  cliente               String?         @db.VarChar(255)
  /// Solicitação de Serviço.
  ss                    String?         @db.VarChar(60)
  descricao             String?
  endereco              String?
  documentos_referencia String?
  status                StatusOrcamento @default(VISITA_TECNICA)
  /// Valor vigente — atualizado a cada revisão registrada.
  valor                 Decimal         @default(0) @db.Decimal(14, 2)
  /// Só pode ser gravado por PLANEJADOR, SUPERVISOR ou ADMIN (validado no service).
  art                   String?         @db.VarChar(120)
  /// Autor do orçamento.
  orcamentista_id       Int?
  /// Só pode ser atribuído por SUPERVISOR ou ADMIN (validado no service).
  planejador_id         Int?
  /// URL Cloudinary da foto principal — obrigatória.
  foto_1                String
  foto_2                String?
  foto_3                String?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  orcamentista Usuario?           @relation("Orcamentista", fields: [orcamentista_id], references: [id], onDelete: SetNull)
  planejador   Usuario?           @relation("Planejador", fields: [planejador_id], references: [id], onDelete: SetNull)
  revisoes     OrcamentoRevisao[]
  fiscais      OrcamentoFiscal[]
  obra         Obra?

  @@index([status])
  @@index([pep])
  @@map("orcamentos")
}

// -----------------------------------------------------------------------------
// Fiscais do orçamento (N por orçamento — nome + contato)
// -----------------------------------------------------------------------------
model OrcamentoFiscal {
  id           Int      @id @default(autoincrement())
  orcamento_id Int
  nome         String   @db.VarChar(255)
  /// Telefone e/ou e-mail de contato do fiscal.
  contato      String?  @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)

  @@index([orcamento_id])
  @@index([nome])
  @@map("orcamento_fiscais")
}

// -----------------------------------------------------------------------------
// Histórico de revisões de valor (versionamento sequencial)
// -----------------------------------------------------------------------------
model OrcamentoRevisao {
  id             Int      @id @default(autoincrement())
  orcamento_id   Int
  /// 0 = Rev 00, 1 = Rev 01, ...
  numero_revisao Int
  valor          Decimal  @db.Decimal(14, 2)
  /// Justificativa obrigatória da alteração de valor.
  observacao     String
  /// Quem gerou a revisão.
  usuario_id     Int?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  orcamento Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@unique([orcamento_id, numero_revisao], name: "uq_revisao_por_orcamento")
  @@map("orcamento_revisoes")
}

// -----------------------------------------------------------------------------
// Obras — ciclo operacional de execução (ISO 9001)
//
// Relação 1:1 com o orçamento aprovado. O orçamento carrega o ciclo comercial
// (levantamento → aprovação); esta tabela carrega a governança de execução:
// documento de partida (OSI + Ata de Reunião) e o ciclo de vida em campo.
// -----------------------------------------------------------------------------
model Obra {
  id              Int        @id @default(autoincrement())
  orcamento_id    Int        @unique
  /// Ciclo de vida operacional em campo.
  status          StatusObra @default(PARA_INICIAR)
  /// Técnico Planejador responsável — atribuído por Gestor/Supervisor.
  planejador_id   Int?
  /// Número da Ordem de Serviço Interna (OSI).
  osi_numero      String?    @db.VarChar(60)
  osi_emitida_em  DateTime?  @db.Timestamptz(6)
  /// Usuário que registrou a emissão da OSI.
  osi_emitida_por Int?
  /// URL Cloudinary da Ata de Reunião de Partida (Kick-off).
  ata_partida_url String?
  /// Observações gerais do planejamento.
  observacoes     String?
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @updatedAt @db.Timestamptz(6)

  orcamento           Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)
  planejador          Usuario?  @relation("ObraPlanejador", fields: [planejador_id], references: [id], onDelete: SetNull)
  osi_emitida_usuario Usuario?  @relation("ObraOsiEmissor", fields: [osi_emitida_por], references: [id], onDelete: SetNull)

  localizacoes  ObraLocalizacao[]
  avanco_fisico ObraAvancoFisico[]
  relatorios    ObraRelatorio[]
  atividades    ObraAtividade[]
  ocorrencias   ObraOcorrencia[]
  comentarios   ObraComentario[]
  midias        ObraMidia[]

  @@index([status])
  @@index([planejador_id])
  @@map("obras")
}

// -----------------------------------------------------------------------------
// Múltiplas localizações da obra (pontos geográficos ou trechos em km)
// -----------------------------------------------------------------------------
model ObraLocalizacao {
  id         Int                 @id @default(autoincrement())
  obra_id    Int
  descricao  String              @db.VarChar(255)
  tipo       TipoLocalizacaoObra @default(PONTO)
  /// Coordenadas do ponto ou do início do trecho.
  latitude   Decimal?            @db.Decimal(10, 7)
  longitude  Decimal?            @db.Decimal(10, 7)
  /// Quilometragem inicial/final para obras lineares (tubulações, ferrovias).
  km_inicial Decimal?            @db.Decimal(10, 3)
  km_final   Decimal?            @db.Decimal(10, 3)
  /// Referência livre (ex.: "KM 12+350", "Portão Norte", "Travessia do rio").
  referencia String?             @db.VarChar(120)
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@map("obra_localizacoes")
}

// -----------------------------------------------------------------------------
// Avanço físico semanal (base histórica da Curva S)
// -----------------------------------------------------------------------------
model ObraAvancoFisico {
  id               Int      @id @default(autoincrement())
  obra_id          Int
  data             DateTime @db.Date
  semana           Int
  /// Avanço previsto no período (percentual da obra).
  fisico_prev      Decimal  @default(0) @db.Decimal(6, 2)
  /// Linha de base prevista no período.
  fisico_lb_prev   Decimal  @default(0) @db.Decimal(6, 2)
  /// Avanço realizado no período.
  fisico_real      Decimal  @default(0) @db.Decimal(6, 2)
  /// Tendência acumulada.
  fisico_tend_acum Decimal  @default(0) @db.Decimal(6, 2)
  /// Previsto acumulado.
  fisico_prev_acum Decimal  @default(0) @db.Decimal(6, 2)
  /// Realizado acumulado.
  fisico_real_acum Decimal  @default(0) @db.Decimal(6, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  obra Obra @relation(fields: [obra_id], references: [id], onDelete: Cascade)

  @@unique([obra_id, semana], name: "uq_avanco_semana_por_obra")
  @@index([obra_id])
  @@map("obra_avanco_fisico")
}

// -----------------------------------------------------------------------------
// Relatório Diário de Obra (RDO) — cabeçalho do registro de campo
// -----------------------------------------------------------------------------
model ObraRelatorio {
  id         Int                 @id @default(autoincrement())
  obra_id    Int
  data       DateTime            @db.Date
  titulo     String              @db.VarChar(200)
  resumo     String?
  status     StatusRelatorioObra @default(RASCUNHO)
  autor_id   Int?
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra        Obra             @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  autor       Usuario?         @relation("RelatorioAutor", fields: [autor_id], references: [id], onDelete: SetNull)
  atividades  ObraAtividade[]
  ocorrencias ObraOcorrencia[]
  comentarios ObraComentario[]
  midias      ObraMidia[]

  @@index([obra_id])
  @@index([data])
  @@map("obra_relatorios")
}

// -----------------------------------------------------------------------------
// Atividades / tarefas da obra (podem pertencer a um RDO ou ser avulsas)
// -----------------------------------------------------------------------------
model ObraAtividade {
  id           Int                 @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  titulo       String              @db.VarChar(200)
  descricao    String?
  status       StatusAtividadeObra @default(PENDENTE)
  responsavel  String?             @db.VarChar(120)
  prazo        DateTime?           @db.Date
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@index([status])
  @@map("obra_atividades")
}

// -----------------------------------------------------------------------------
// Ocorrências registradas em campo (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraOcorrencia {
  id           Int                 @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  descricao    String
  gravidade    GravidadeOcorrencia @default(MEDIA)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@map("obra_ocorrencias")
}

// -----------------------------------------------------------------------------
// Comentários da obra (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraComentario {
  id           Int      @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  autor_id     Int?
  texto        String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)
  autor     Usuario?       @relation("ComentarioAutor", fields: [autor_id], references: [id], onDelete: SetNull)

  @@index([obra_id])
  @@index([relatorio_id])
  @@map("obra_comentarios")
}

// -----------------------------------------------------------------------------
// Fotos e vídeos da obra (podem pertencer a um RDO)
// -----------------------------------------------------------------------------
model ObraMidia {
  id           Int           @id @default(autoincrement())
  obra_id      Int
  relatorio_id Int?
  tipo         TipoMidiaObra @default(FOTO)
  url          String
  legenda      String?       @db.VarChar(255)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)

  obra      Obra           @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  relatorio ObraRelatorio? @relation(fields: [relatorio_id], references: [id], onDelete: Cascade)

  @@index([obra_id])
  @@index([relatorio_id])
  @@index([tipo])
  @@map("obra_midias")
}

# =============================================================================
# Synapse - Back-end (Express + Prisma + Neon PostgreSQL)
# Copie este arquivo para `.env` e preencha os valores reais.
#   cp .env.example .env
# =============================================================================

# --- Banco de dados (Neon PostgreSQL) ----------------------------------------
# Obrigatória. Use a connection string "pooled" do Neon (host com -pooler).
# O TLS é negociado via `sslmode=require` na própria URL.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Servidor -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Autenticação JWT ---------------------------------------------------------
# Em produção use um segredo longo e aleatório (ex.: openssl rand -hex 32).
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# --- Cloudinary (upload das fotos da vistoria/obra) ---------------------------
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# --- Otimização de imagens (Sharp -> WebP antes do Cloudinary) ----------------
CLOUDINARY_FOLDER=synapse/orcamentos
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_WIDTH=1920
UPLOAD_WEBP_QUALITY=80

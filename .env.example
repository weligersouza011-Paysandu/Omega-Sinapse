# =============================================================================
# Synapse - Back-end (Express + Prisma + Neon PostgreSQL)
# Copie este arquivo para `.env` e preencha os valores reais.
#   cp .env.example .env
# =============================================================================

# --- Banco de dados (Neon PostgreSQL) ----------------------------------------
# Obrigatória. Use a connection string "pooled" do Neon (host com -pooler).
# O TLS é negociado via `sslmode=require` na própria URL.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Servidor -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Autenticação JWT ---------------------------------------------------------
# Em produção use um segredo longo e aleatório (ex.: openssl rand -hex 32).
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# --- Cloudinary (upload das fotos da vistoria/obra) ---------------------------
# CLOUDINARY_CLOUD_NAME é só o nome da nuvem (ex.: minhanuvem), SEM "@".
# Alternativa: defina apenas CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# --- Otimização de imagens (Sharp -> WebP antes do Cloudinary) ----------------
CLOUDINARY_FOLDER=synapse/orcamentos
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_WIDTH=1920
UPLOAD_WEBP_QUALITY=80

# --- E-mail diário de pendências (07:30, America/Sao_Paulo) -------------------
# Sem provedor configurado o job apenas registra no log (nada quebra em ambiente local).
#
# Opção 1 (recomendada em hospedagem): Brevo por API HTTPS. Funciona no Render gratuito,
# que bloqueia SMTP. EMAIL_FROM deve ser um remetente verificado no Brevo.
BREVO_API_KEY=
#
# Opção 2 (uso local): SMTP (ex.: Gmail com senha de app). Ignorado se BREVO_API_KEY existir.
SMTP_HOST=
SMTP_PORT=587
# "true" para TLS direto (porta 465); em 587 o STARTTLS é negociado.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Omega Sinapse <nao-responder@suaempresa.com.br>
# Horário do disparo (HH:mm, fuso de Brasília) e chave para desligar o job.
EMAIL_DIARIO_HORA=07:30
EMAIL_DIARIO_ATIVO=true

# --- Leitor de cronogramas do MS Project (.mpp) -------------------------------
# Instalado no build por `npm run instalar:mpxj` (Java + MPXJ em vendor/mpxj).
# No Windows/macOS de desenvolvimento, aponte para um Java 11+ já instalado:
# MPXJ_JAVA=C:\caminho\para\java.exe
# MPXJ_XMX=256m
